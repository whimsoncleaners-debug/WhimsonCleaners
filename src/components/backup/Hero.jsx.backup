import { useEffect, useRef, useState } from 'react';
import { motion } from 'framer-motion';
import { FaWhatsapp, FaPhone, FaStar } from 'react-icons/fa';
import { HiArrowDown } from 'react-icons/hi';

const PARTICLES = Array.from({ length: 30 }, (_, i) => ({
  id: i,
  x: Math.random() * 100,
  y: Math.random() * 100,
  size: Math.random() * 3 + 1,
  delay: Math.random() * 5,
  duration: Math.random() * 10 + 8,
}));

export default function Hero() {
  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });

  useEffect(() => {
    const onMove = (e) => {
      setMousePos({
        x: (e.clientX / window.innerWidth - 0.5) * 20,
        y: (e.clientY / window.innerHeight - 0.5) * 20,
      });
    };
    window.addEventListener('mousemove', onMove);
    return () => window.removeEventListener('mousemove', onMove);
  }, []);

  return (
    <section
      id="home"
      className="relative min-h-screen flex items-center overflow-hidden"
      style={{ background: 'linear-gradient(135deg, #060e1f 0%, #0a1628 40%, #0d1f3c 100%)' }}
    >
      {/* Radial glow blobs */}
      <div
        className="absolute top-0 left-0 w-[600px] h-[600px] rounded-full pointer-events-none"
        style={{
          background: 'radial-gradient(circle, rgba(0,194,232,0.12) 0%, transparent 70%)',
          transform: `translate(${mousePos.x * 0.5}px, ${mousePos.y * 0.5}px)`,
          transition: 'transform 0.3s ease',
        }}
      />
      <div
        className="absolute bottom-0 right-0 w-[500px] h-[500px] rounded-full pointer-events-none"
        style={{ background: 'radial-gradient(circle, rgba(0,153,204,0.08) 0%, transparent 70%)' }}
      />

      {/* Particles */}
      {PARTICLES.map((p) => (
        <motion.div
          key={p.id}
          className="particle absolute"
          style={{ left: `${p.x}%`, top: `${p.y}%`, width: p.size, height: p.size }}
          animate={{
            y: [0, -30, 0],
            opacity: [0.2, 0.8, 0.2],
          }}
          transition={{
            duration: p.duration,
            delay: p.delay,
            repeat: Infinity,
            ease: 'easeInOut',
          }}
        />
      ))}

      {/* Grid lines */}
      <div
        className="absolute inset-0 pointer-events-none opacity-[0.04]"
        style={{
          backgroundImage:
            'linear-gradient(rgba(0,194,232,1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,194,232,1) 1px, transparent 1px)',
          backgroundSize: '80px 80px',
        }}
      />

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-24 pb-16">
        <div className="grid lg:grid-cols-2 gap-12 items-center">
          {/* Left Content */}
          <div>
            {/* Badge */}
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.5 }}
              className="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full glass border border-[rgba(0,194,232,0.25)]"
            >
              <div className="w-2 h-2 rounded-full bg-[var(--cyan)] animate-pulse" />
              <span className="text-[var(--cyan)] text-sm font-medium tracking-wide">Trusted by 500+ Clients</span>
              <div className="flex gap-0.5">
                {[...Array(5)].map((_, i) => (
                  <FaStar key={i} className="text-yellow-400 text-xs" />
                ))}
              </div>
            </motion.div>

            {/* Heading */}
            <motion.h1
              initial={{ opacity: 0, y: 30 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.1 }}
              className="bebas leading-none mb-4"
              style={{ fontSize: 'clamp(52px, 8vw, 100px)' }}
            >
              <span className="text-white">WINDOW</span>
              <br />
              <span className="gradient-text text-glow">CLEANING</span>
              <br />
              <span className="text-white">SERVICES</span>
            </motion.h1>

            <motion.p
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.2 }}
              className="text-[var(--gray)] text-lg md:text-xl mb-8 max-w-lg leading-relaxed"
            >
              Say goodbye to dirt and grime with our expert cleaning solutions.
              <span style={{ color: 'var(--cyan)' }}> Crystal clear results, every time.</span>
            </motion.p>

            {/* CTA Buttons */}
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.3 }}
              className="flex flex-wrap gap-4 mb-10"
            >
              <a
                href="https://wa.me/14319905410"
                target="_blank"
                rel="noreferrer"
                className="flex items-center gap-3 bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold px-7 py-4 rounded-full transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(37,211,102,0.4)] text-base"
              >
                <FaWhatsapp size={20} />
                Contact on WhatsApp
              </a>
              <a
                href="#contact"
                className="flex items-center gap-3 bg-transparent border-2 border-[var(--cyan)] text-[var(--cyan)] hover:bg-[var(--cyan)] hover:text-[var(--navy)] font-bold px-7 py-4 rounded-full transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(0,194,232,0.3)] text-base"
              >
                Get Free Quote
              </a>
            </motion.div>

            {/* Stats row */}
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              transition={{ duration: 0.8, delay: 0.5 }}
              className="flex gap-8"
            >
              {[
                { num: '500+', label: 'Happy Clients' },
                { num: '5yrs', label: 'Experience' },
                { num: '99%', label: 'Satisfaction' },
              ].map((s) => (
                <div key={s.label}>
                  <div className="bebas text-3xl text-[var(--cyan-bright)]">{s.num}</div>
                  <div className="text-[var(--gray)] text-xs uppercase tracking-wider">{s.label}</div>
                </div>
              ))}
            </motion.div>
          </div>

          {/* Right — Visual */}
          <div className="relative flex justify-center lg:justify-end">
            {/* 45% OFF Badge */}
            <motion.div
              initial={{ scale: 0, rotate: -20 }}
              animate={{ scale: 1, rotate: 0 }}
              transition={{ type: 'spring', stiffness: 200, delay: 0.7 }}
              className="absolute -top-4 right-4 lg:-top-6 lg:right-0 z-20 w-28 h-28 rounded-full flex flex-col items-center justify-center font-black text-[var(--navy)] pulse-btn"
              style={{ background: 'linear-gradient(135deg, var(--cyan-bright), var(--cyan))' }}
            >
              <span className="bebas text-4xl leading-none">45%</span>
              <span className="text-xs font-bold tracking-widest">OFF</span>
            </motion.div>

            {/* Main image card */}
            <motion.div
              initial={{ opacity: 0, x: 60 }}
              animate={{ opacity: 1, x: 0 }}
              transition={{ duration: 0.8, delay: 0.4 }}
              className="relative"
              style={{ filter: `drop-shadow(0 30px 60px rgba(0,194,232,0.2))` }}
            >
              {/* Spinning ring */}
              <div
                className="absolute -inset-4 rounded-full border border-[rgba(0,194,232,0.2)] spin-slow"
                style={{ borderStyle: 'dashed' }}
              />
              <div
                className="absolute -inset-8 rounded-full border border-[rgba(0,194,232,0.08)] spin-slow"
                style={{ borderStyle: 'dashed', animationDirection: 'reverse' }}
              />

              {/* Image circle */}
              <div
                className="w-72 h-72 md:w-96 md:h-96 rounded-full overflow-hidden border-4 border-[var(--cyan)] float-anim"
                style={{ boxShadow: '0 0 60px rgba(0,194,232,0.3), inset 0 0 60px rgba(0,0,0,0.3)' }}
              >
                <img
                  src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&q=80"
                  alt="Professional window cleaning"
                  className="w-full h-full object-cover"
                  loading="eager"
                />
              </div>

              {/* Second floating image */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.9 }}
                className="absolute -bottom-8 -left-8 w-36 h-36 rounded-2xl overflow-hidden border-2 border-[var(--cyan)] float-anim-delay"
                style={{ boxShadow: '0 0 30px rgba(0,194,232,0.3)' }}
              >
                <img
                  src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=300&q=80"
                  alt="Cleaning tools"
                  className="w-full h-full object-cover"
                />
              </motion.div>
            </motion.div>
          </div>
        </div>
      </div>

      {/* Scroll indicator */}
      <motion.a
        href="#services"
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ delay: 1.2 }}
        className="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-[var(--gray)] hover:text-[var(--cyan)] transition-colors"
      >
        <span className="text-xs tracking-widest uppercase">Scroll</span>
        <motion.div
          animate={{ y: [0, 8, 0] }}
          transition={{ duration: 1.5, repeat: Infinity }}
        >
          <HiArrowDown size={20} />
        </motion.div>
      </motion.a>
    </section>
  );
}
